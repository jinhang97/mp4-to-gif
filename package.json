{
  "name": "mp4-to-gif",
  "version": "1.0.0",
  "description": "MP4 转 GIF 桌面工具，GIF 默认无限循环播放",
  "author": "local",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-convert.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.local.mp4togif",
    "productName": "MP4toGIF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
